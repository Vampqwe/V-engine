  <table class="data">
    <tr><th></th><th>Проверка</th><th>Статус</th><th>Сообщение</th></tr>
    <?php foreach ($stats['health']['checks'] as $c): $cls = lex_adm_health_class((string) ($c['status'] ?? '')); ?>
    <tr>
      <td><?= $esc(lex_adm_icon($cls)) ?></td>
      <td><strong><?= $esc($c['name'] ?? '?') ?></strong></td>
      <td><span class="badge <?= $esc($cls) ?>"><?= $esc($c['status'] ?? '?') ?></span></td>
      <td style="color:var(--fg-muted)"><?= $esc($c['message'] ?? '') ?><?php if (!empty($c['context']) && is_array($c['context'])): ?> <span class="mono" style="font-size:11px"><?= $esc(json_encode($c['context'], JSON_UNESCAPED_UNICODE)) ?></span><?php endif; ?></td>
    </tr>
    <?php endforeach; ?>
  </table>
  <?php endif; ?>
</div>
