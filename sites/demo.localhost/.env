# sites/demo.localhost/.env — секреты и средо-зависимые значения ЭТОГО сайта.
# Файл НЕ коммитится (см. корневой .gitignore). Здесь — демо-значения.
APP_ENV=production
CORE_DEBUG=false
APP_SECRET=change-me-to-a-random-64-char-secret-string-0123456789abcdef
SESSION_DRIVER=file
CACHE_DRIVER=file
DB_ENABLED=false

# Демо: SQLite для проверки миграций (в продакшене — MySQL DSN или пусто)
DB_DSN=sqlite:/workspace/sites/demo.localhost/storage/demo.sqlite
