# Шаблон: скопировать в .env и заполнить РЕАЛЬНЫМИ значениями. .env не коммитится!
APP_ENV=production
CORE_DEBUG=false
# Сгенерировать: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=dev-only-secret-please-replace-0123456789abcdef
SESSION_DRIVER=file
CACHE_DRIVER=file
DB_ENABLED=false
DB_DSN=
DB_USER=
DB_PASS=
