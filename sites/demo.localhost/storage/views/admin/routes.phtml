<?php declare(strict_types=1); ?>
<?php include __DIR__ . '/helpers.php'; ?>
<?php include __DIR__ . '/layout.phtml'; ?>
<h1 class="page-title">Маршруты</h1>
<p class="page-sub">Все зарегистрированные маршруты Router ядра и сайта.</p>
<div class="card">
  <div class="card-h">Таблица маршрутов <span class="hint"><?= (int) ($stats['routes']['total'] ?? 0) ?> шт</span></div>
