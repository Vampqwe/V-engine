# ==============================================================================
# LEX Engine — корневой шаблон окружения движка (копировать в .env на хостинге)
# Конституция §8.1: конфигурация слоистая; секреты живут только в .env, не в PHP-файлах.
# Многосайтовость (принятое решение): SITE_URL жёстко привязан к папке сайта:
#   SITE_URL=https://mysite.com  =>  sites/mysite.com/
# Каждый сайт имеет СОБСТВЕННЫЙ sites/<домен>/.env — этот файл задаёт лишь
# значения по умолчанию для CLI/демо-режима и режим самого движка.
# ==============================================================================

# --- Режим движка -------------------------------------------------------------
# true только на dev! В продакшене малейшая утечка стека = инцидент (§31).
CORE_DEBUG=true
APP_ENV=production
APP_TIMEZONE=UTC

# --- Доверенные прокси (для X-Forwarded-*) -------------------------------------
# Список IP через запятую; пусто — прокси не доверяем.
TRUSTED_PROXIES=

# --- Демо-сайт (используется public/index.php при отсутствии HTTP_HOST) --------
# CLI/встроенный сервер PHP: php -S localhost:8080 -t public public/index.php
SITE_URL=https://demo.localhost
