# ==============================================================================
# sites/newsite.local/.env — секреты и средо-зависимые значения ЭТОГО сайта.
# 1) Скопировать в .env:   cp .env.example .env
# 2) Заполнить реальными значениями. Файл .env НИКОГДА не коммитится (§8.1).
#    Привязка домена к папке: ИМЯ ПАПКИ = ДОМЕН (см. docs/START-HERE.md §1).
# ==============================================================================

APP_ENV=production
CORE_DEBUG=false

# Секрет сайта (CSRF, подпись cookie, HMAC). Сгенерировать:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# --- Сессии: file | redis | migrating ---------------------------------------
SESSION_DRIVER=file
# SESSION_REDIS_HOST=127.0.0.1
# SESSION_REDIS_PORT=6379

# --- Кэш ---------------------------------------------------------------------
CACHE_DRIVER=file

# --- База данных: сайт живёт БЕЗ БД (enabled=false). Подключите при нужде: --
DB_ENABLED=false
DB_DSN=mysql:host=127.0.0.1;dbname=newsite;charset=utf8mb4
DB_USER=
DB_PASS=

# --- Почта (Notification) ------------------------------------------------------
# MAIL_METHOD=log | smtp | mail ; для smtp раскомментируйте блок ниже
MAIL_METHOD=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@newsite.local
